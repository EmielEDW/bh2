# ---- Boekhouden 2: env-variabelen (kopieer naar .env.local en vul in) ----

# Publiek (mag client-side): de Stripe Payment Link en de prijs voor weergave.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/xxxxxxxx
NEXT_PUBLIC_PRIJS=€15
NEXT_PUBLIC_SITE_URL=https://bh2.emieldewaele.com

# Stripe (server). De webhook secret krijg je bij het aanmaken van de webhook-endpoint.
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optioneel: enkel nodig als je 1 Stripe-account deelt met je andere sites.
# De 'plink_...'-id van DEZE pack (Payment Link → ... → API ID). Dan negeert de
# webhook betalingen van je andere sites.
STRIPE_PAYMENT_LINK_ID=plink_xxx

# Resend (e-mail met de code na betaling). Domein moet geverifieerd zijn in Resend.
RESEND_API_KEY=re_xxx
RESEND_FROM=Boekhouden 2 <noreply@bh2.emieldewaele.com>
ADMIN_EMAIL=jij@voorbeeld.com

# Upstash Redis (opslag van codes + toestel-registratie).
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx
