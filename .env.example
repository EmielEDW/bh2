# ---- Boekhouden 2: env-variabelen (dezelfde aanpak als je andere sites) ----
# Kopieer naar .env.local (lokaal) en zet ze in Vercel → Settings → Environment Variables.

# --- Publiek (client) ---
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/xxxxxxxx
NEXT_PUBLIC_PRIJS=€15

# --- Site / e-mail ---
SITE_URL=https://bh2.emieldewaele.com
REPLY_TO_EMAIL=info@emieldewaele.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optioneel: enkel als je 1 Stripe-account deelt met je andere sites.
# De 'plink_...'-id van DEZE pack -> webhook negeert dan andere producten.
STRIPE_PAYMENT_LINK_ID=plink_xxx

# --- Resend (e-mail met de code) ---
RESEND_API_KEY=re_xxx
RESEND_FROM=Boekhouden 2 <info@emieldewaele.com>

# --- Beveiliging ---
HMAC_SECRET=een-lange-willekeurige-string
ADMIN_SECRET=een-andere-lange-willekeurige-string
MAX_DEVICES=2

# --- Vercel KV / Upstash (worden automatisch toegevoegd als je een KV-store koppelt) ---
KV_REST_API_URL=https://xxx.kv.vercel-storage.com
KV_REST_API_TOKEN=xxx
# (KV_URL, KV_REDIS_URL en KV_REST_API_READ_ONLY_TOKEN worden ook toegevoegd maar zijn niet nodig)
